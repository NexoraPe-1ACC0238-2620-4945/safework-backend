# Names only. Enter secrets privately; Spring does not automatically load this file.
APP_PROFILE=prod
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=7
# Recommended in Render: upload Aiven ca.pem as Secret File ca.pem.
# Alternative PEM input (choose one); no manual truststore password is needed.
DB_CA_CERT_PATH=
DB_CA_CERT_BASE64=
# Advanced legacy PKCS12 input only; do not combine with the PEM variables.
DB_TRUSTSTORE_URL=
DB_TRUSTSTORE_BASE64=
DB_TRUSTSTORE_PASSWORD=
DDL_AUTO=validate
MIGRATIONS_ENABLED=false
# Local tests explicitly use APP_PROFILE=dev, loopback and synthetic credentials.
# SAFEWORK_MIGRATE_ENABLED / SAFEWORK_PASSWORD_RESET_ENABLED are one-shot child flags,
# never permanent variables of the normal web service.
